{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/auditor",
      "destination": "/api/auditor"
    },
    {
      "source": "/api/colonias/(.*)",
      "destination": "/api/colonias"
    },
    {
      "source": "/api/colonias",
      "destination": "/api/colonias"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/[...all]"
    }
  ]
}
